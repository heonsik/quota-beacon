<?xml version="1.0" encoding="utf-8"?>
<!--
  Produces the file you hand out: one self-contained QuotaBeacon.exe that runs with no .NET
  installed, no installer, and no administrator rights.

  IncludeNativeLibrariesForSelfExtract is what makes it genuinely one file — without it the native
  WPF and WebView2 libraries sit beside the executable. EnableCompressionInSingleFile roughly halves
  the size, at the cost of a little first-launch decompression, which is invisible for something that
  then lives in the tray.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\Publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
