<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WPF has no tray primitive, so NotifyIcon comes from WinForms. Icon and menu only. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>QuotaBeacon</AssemblyName>
    <RootNamespace>QuotaBeacon.App</RootNamespace>
    <ApplicationIcon>Assets\QuotaBeacon.ico</ApplicationIcon>
    <!-- Keeps IntelliSense .xml and .pdb of referenced packages out of publish, so the published
         folder really is just the executable. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuotaBeacon.Core\QuotaBeacon.Core.csproj" />
    <ProjectReference Include="..\QuotaBeacon.Providers\QuotaBeacon.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded as a resource as well as set on the executable, so windows can show it too. -->
    <Resource Include="Assets\QuotaBeacon.ico" />
  </ItemGroup>

</Project>
