<Window x:Class="QuotaBeacon.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QuotaBeacon.App.Controls"
        xmlns:views="clr-namespace:QuotaBeacon.App.Views"
        xmlns:theming="clr-namespace:QuotaBeacon.App.Theming"
        Title="QuotaBeacon"
        Width="430"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource Brush.Surface}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource Brush.Foreground}">

  <Window.Resources>
    <views:NegatedBooleanToVisibilityConverter x:Key="NotToVisibility" />
    <views:EmptyStringToVisibilityConverter x:Key="TextToVisibility" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Severity is applied by trigger rather than by a converter so the brushes stay dynamic and a
         theme switch repaints without rebuilding view models. -->
    <Style x:Key="MeterGauge" TargetType="controls:Gauge">
      <Setter Property="Height" Value="8" />
      <Setter Property="Track" Value="{DynamicResource Brush.Track}" />
      <Setter Property="Fill" Value="{DynamicResource Brush.Fill.Normal}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="Warning">
          <Setter Property="Fill" Value="{DynamicResource Brush.Fill.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="Critical">
          <Setter Property="Fill" Value="{DynamicResource Brush.Fill.Critical}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SeverityText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="Warning">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="Critical">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Critical}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Hairline" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.Hairline}" />
    </Style>

    <!-- Flat icon button: presence comes from a hover wash, not from a border. -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tab" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="False" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Normal}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="2,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.75" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One provider in the comparison view. -->
    <DataTemplate x:Key="ProviderRow">
      <StackPanel Margin="0,15">
        <Grid>
          <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding LevelText}"
                       Style="{StaticResource SeverityText}"
                       DataContext="{Binding Headline}"
                       FontSize="11"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding LevelText, Converter={StaticResource TextToVisibility}}" />
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding Headline.IsRatio, Converter={StaticResource BoolToVisibility}}">
              <controls:AnimatedNumber Value="{Binding Headline.RemainingPercent}"
                                       Format="0"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="21"
                                       FontWeight="Medium"
                                       Typography.NumeralAlignment="Tabular" />
              <TextBlock Text="%"
                         FontSize="13"
                         Margin="1,0,0,2"
                         VerticalAlignment="Bottom"
                         Foreground="{DynamicResource Brush.Muted}" />
            </StackPanel>
            <TextBlock Text="{Binding Headline.AmountText}"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="19"
                       FontWeight="Medium"
                       Typography.NumeralAlignment="Tabular"
                       Visibility="{Binding Headline.IsRatio, Converter={StaticResource NotToVisibility}}" />
          </StackPanel>
        </Grid>

        <!-- Visibility is driven by the provider, but the gauge itself stays scoped to the headline
             meter so the severity triggers in its style can still see Level. -->
        <Decorator Margin="0,11,0,0"
                   Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}">
          <controls:Gauge Value="{Binding RemainingFraction}"
                          Style="{StaticResource MeterGauge}"
                          DataContext="{Binding Headline}" />
        </Decorator>

        <Grid Margin="0,7,0,0" Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding Headline.MetaLeft}" Style="{StaticResource Label}" />
          <TextBlock Text="{Binding Headline.MetaRight}"
                     Style="{StaticResource Label}"
                     HorizontalAlignment="Right" />
        </Grid>

        <TextBlock Text="{Binding Headline.NoLimitHint}"
                   Style="{StaticResource Label}"
                   Foreground="{DynamicResource Brush.Subtle}"
                   Margin="0,5,0,0"
                   Visibility="{Binding Headline.NoLimitHint, Converter={StaticResource TextToVisibility}}" />

        <!-- Errors live in the affected provider's own row, never in a dialog. -->
        <StackPanel Margin="0,9,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding ErrorText}"
                     Style="{StaticResource Label}"
                     TextWrapping="Wrap"
                     TextTrimming="None" />
          <Button Content="{Binding [Action.SignIn], Source={x:Static theming:Localization.Current}}"
                  Style="{StaticResource LinkButton}"
                  HorizontalAlignment="Left"
                  Margin="0,4,0,0"
                  Click="OnSignInClick"
                  Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- One supporting meter in a detail view. -->
    <DataTemplate x:Key="DetailRow">
      <Grid Margin="0,11">
        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" Foreground="{DynamicResource Brush.Foreground}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding IsRatio, Converter={StaticResource BoolToVisibility}}">
            <controls:AnimatedNumber Value="{Binding RemainingPercent}"
                                     Format="0"
                                     FontSize="12.5"
                                     FontWeight="Medium"
                                     Typography.NumeralAlignment="Tabular" />
            <TextBlock Text="%" FontSize="12.5" FontWeight="Medium" />
          </StackPanel>
          <TextBlock Text="{Binding AmountText}"
                     FontSize="12.5"
                     FontWeight="Medium"
                     Typography.NumeralAlignment="Tabular"
                     Visibility="{Binding IsRatio, Converter={StaticResource NotToVisibility}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Card"
          Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.CardBorder}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="18,16,18,14">
    <StackPanel>

      <!-- Header -->
      <Grid x:Name="HeaderBar" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="20" Height="20" Margin="0,0,8,0">
            <Ellipse x:Name="BeaconGlow" Width="20" Height="20" Opacity="0.20" />
            <Ellipse x:Name="Beacon" Width="9" Height="9" />
          </Grid>
          <TextBlock Text="QuotaBeacon" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Icons are drawn rather than set as glyphs so they cannot fall back to a missing-font box. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="PinButton"
                  Style="{StaticResource IconButton}"
                  Click="OnPinClick">
            <Path x:Name="PinIcon" Width="15" Height="15" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M9.6 1.2 14.8 6.4 13.4 7.8 12.6 7.6 10.1 10.1 10.4 12.6 9.2 13.8 5.9 10.5 2.4 14 2 13.6 5.5 10.1 2.2 6.8 3.4 5.6 5.9 5.9 8.4 3.4 8.2 2.6Z" />
          </Button>

          <Button Style="{StaticResource IconButton}"
                  ToolTip="{Binding [Tooltip.Settings], Source={x:Static theming:Localization.Current}}"
                  Click="OnSettingsClick">
            <Path Width="15" Height="15" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M8 5.2A2.8 2.8 0 1 0 8 10.8A2.8 2.8 0 1 0 8 5.2 M7.1 1h1.8l.3 1.7 1.2.5 1.4-1 1.3 1.3-1 1.4.5 1.2 1.7.3v1.8l-1.7.3-.5 1.2 1 1.4-1.3 1.3-1.4-1-1.2.5-.3 1.7H7.1l-.3-1.7-1.2-.5-1.4 1L2.9 12l1-1.4-.5-1.2L1.7 9V7.2l1.7-.3.5-1.2-1-1.4 1.3-1.3 1.4 1 1.2-.5z" />
          </Button>

          <Button x:Name="MinimizeButton"
                  Style="{StaticResource IconButton}"
                  Visibility="Collapsed"
                  ToolTip="{Binding [Tooltip.Minimize], Source={x:Static theming:Localization.Current}}"
                  Click="OnMinimizeClick">
            <Rectangle Width="11" Height="1.4"
                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>

          <Button x:Name="CloseButton"
                  Style="{StaticResource IconButton}"
                  Visibility="Collapsed"
                  ToolTip="{Binding [Tooltip.Close], Source={x:Static theming:Localization.Current}}"
                  Click="OnCloseClick">
            <Path Width="11" Height="11" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.3"
                  Data="M1 1 L11 11 M11 1 L1 11" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Tabs -->
      <Border x:Name="TabStrip"
              Background="{DynamicResource Brush.Track}"
              CornerRadius="8"
              Height="32"
              Padding="2"
              Margin="0,14,0,0"
              SizeChanged="OnTabStripSizeChanged">
        <Grid>
          <Border x:Name="TabIndicator"
                  Background="{DynamicResource Brush.Elevated}"
                  CornerRadius="6"
                  HorizontalAlignment="Left"
                  Width="0">
            <Border.RenderTransform>
              <TranslateTransform x:Name="TabIndicatorOffset" />
            </Border.RenderTransform>
          </Border>
          <Grid x:Name="TabButtons">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
          </Grid>
        </Grid>
      </Border>

      <!-- Panels -->
      <Grid x:Name="Panels" Margin="0,4,0,0">
        <ItemsControl x:Name="AllPanel"
                      ItemsSource="{Binding Providers}"
                      ItemTemplate="{StaticResource ProviderRow}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <views:SeparatedStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ContentControl x:Name="DetailPanel" Visibility="Collapsed">
          <ContentControl.ContentTemplate>
            <DataTemplate>
              <StackPanel>
                <StackPanel Margin="0,16,0,18" HorizontalAlignment="Center"
                            Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                              Visibility="{Binding Headline.IsRatio, Converter={StaticResource BoolToVisibility}}">
                    <controls:AnimatedNumber Value="{Binding Headline.RemainingPercent}"
                                             Format="0"
                                             FontFamily="Segoe UI Variable Display, Segoe UI"
                                             FontSize="44"
                                             FontWeight="Medium"
                                             Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="%" FontSize="20" VerticalAlignment="Bottom" Margin="2,0,0,6"
                               Foreground="{DynamicResource Brush.Muted}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Headline.AmountText}"
                             FontFamily="Segoe UI Variable Display, Segoe UI"
                             FontSize="40"
                             FontWeight="Medium"
                             HorizontalAlignment="Center"
                             Typography.NumeralAlignment="Tabular"
                             Visibility="{Binding Headline.IsRatio, Converter={StaticResource NotToVisibility}}" />
                  <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Run Text="{Binding Headline.Label, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Headline.LimitText, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>

                <controls:Gauge Value="{Binding RemainingFraction}"
                                Style="{StaticResource MeterGauge}"
                                DataContext="{Binding Headline}" />

                <Grid Margin="0,8,0,0">
                  <TextBlock Text="{Binding Headline.NoLimitHint}"
                             Style="{StaticResource Label}"
                             Foreground="{DynamicResource Brush.Subtle}"
                             Visibility="{Binding Headline.NoLimitHint, Converter={StaticResource TextToVisibility}}" />
                  <TextBlock Text="{Binding Headline.MetaRight}"
                             Style="{StaticResource Label}"
                             HorizontalAlignment="Right" />
                </Grid>

                <ItemsControl ItemsSource="{Binding SupportingMeters}"
                              ItemTemplate="{StaticResource DetailRow}"
                              Margin="0,10,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <views:SeparatedStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Margin="0,14,0,4"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Label}" TextWrapping="Wrap" TextTrimming="None" />
                  <Button Content="{Binding [Action.SignIn], Source={x:Static theming:Localization.Current}}"
                          Style="{StaticResource LinkButton}"
                          HorizontalAlignment="Left"
                          Margin="0,6,0,0"
                          Click="OnSignInClick"
                          Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Grid>

      <!-- Footer -->
      <Border Style="{StaticResource Hairline}" Margin="0,10,0,0" />
      <Grid Margin="0,10,0,0">
        <TextBlock x:Name="FooterText"
                   Text="{Binding FooterText}"
                   FontSize="11"
                   Foreground="{DynamicResource Brush.Subtle}"
                   VerticalAlignment="Center" />
        <Button x:Name="RefreshButton"
                Style="{StaticResource LinkButton}"
                HorizontalAlignment="Right"
                Foreground="{DynamicResource Brush.Muted}"
                Click="OnRefreshClick"
                Content="{Binding [Action.Refresh], Source={x:Static theming:Localization.Current}}" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
