<Window x:Class="QuotaBeacon.App.Views.WebSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="520"
        Height="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Title="Sign in">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Stating plainly whose window this is, because a sign-in form inside a third-party app should
         never be ambiguous about where the credentials are going. -->
    <StackPanel Margin="16,14,16,12">
      <TextBlock x:Name="Heading" FontSize="14" FontWeight="Medium" />
      <TextBlock x:Name="Explanation"
                 FontSize="11.5"
                 Foreground="{DynamicResource Brush.Muted}"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0" />
      <TextBlock x:Name="CurrentHost"
                 FontSize="11"
                 FontWeight="Medium"
                 Foreground="{DynamicResource Brush.Foreground}"
                 Margin="0,6,0,0" />
    </StackPanel>

    <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
  </Grid>
</Window>
